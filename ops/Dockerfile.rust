# syntax=docker/dockerfile:1.7
# Build tooling is confined to this stage; installed Ops contains native binaries only.
ARG RUST_BUILDER=rust:1.100.0-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea
FROM ${RUST_BUILDER} AS builder
ARG TARGETARCH
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY rust/ rust/
COPY loom_use/ loom_use/
COPY ops/build-info.json ops/build-info.json
ENV LOOM_BUILD_INFO=ops/build-info.json
COPY LICENSE THIRD_PARTY_NOTICES.md ./
RUN --mount=type=cache,id=loom-registry-rust-1.100.0,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=loom-target-rust-1.100.0-bookworm-${TARGETARCH}-release,target=/src/target,sharing=locked \
    cargo build --release --locked --workspace && \
    mkdir /native-bin /native-licenses && \
    cp target/release/loom-ops target/release/loom-host target/release/loom-sdk target/release/loom-migrate /native-bin/ && \
    find /usr/local/cargo/registry/src -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' -o -iname 'COPYRIGHT*' \) -exec cp --parents {} /native-licenses/ \;
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/loom/
COPY --from=builder /native-licenses/ /usr/share/doc/loom/rust-licenses/
COPY --from=builder /native-bin/ /usr/local/bin/
ENV LOOM_STATE=/loom/ops LOOM_DATA=/loom/bulk LOOM_COMPONENTS=/loom/components
ENTRYPOINT ["loom-ops","--listen","0.0.0.0:8080"]
