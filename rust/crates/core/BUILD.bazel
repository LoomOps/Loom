filegroup(name = "sources", srcs = glob(["src/**", "Cargo.toml"]) + glob(["build.rs"], allow_empty = True))
rust_library(name = "core", crate_name = "loom_core", srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]), edition = "2021", version = "0.2.0", aliases = aliases(), deps = ["//rust/crates/domain:domain", "//rust/crates/primitives:primitives", "//rust/crates/contracts:contracts"] + all_crate_deps(normal = True), compile_data = ["//rust:contracts", "//rust:templates", "//rust/crates/sdk:sources"])

