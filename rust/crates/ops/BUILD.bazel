rust_test(name = "ops_test", crate_name = "loom_ops", crate_root = "src/lib.rs", srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]) + ["//tests/rust:updates.rs", "//tests/rust:read_admission.rs", "//tests/rust:worker.rs"], edition = "2021", version = "0.2.0", aliases = aliases(), deps = ["//rust/crates/core:core", "//rust/crates/host:host", "//rust/crates/domain:domain", "//rust/crates/reference:reference"] + all_crate_deps(normal = True), compile_data = [])
