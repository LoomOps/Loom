load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps", "aliases")
package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])
filegroup(name = "sources", srcs = glob(["src/**", "Cargo.toml"]) + glob(["build.rs"], allow_empty = True))
rust_library(name = "sdk", crate_name = "loom_sdk", srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]), edition = "2021", version = "0.2.0", aliases = aliases(), deps = [] + all_crate_deps(normal = True), compile_data = [])
rust_binary(name = "loom-sdk", crate_name = "loom_sdk", srcs = ["src/main.rs"], edition = "2021", version = "0.2.0", aliases = aliases(), deps = [":sdk"] + [] + all_crate_deps(normal = True))

rust_test(name = "sdk_test", crate_name = "loom_sdk", crate_root = "src/lib.rs", srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]) + ["//tests/rust:sdk.rs"], edition = "2021", version = "0.2.0", aliases = aliases(), deps = [] + all_crate_deps(normal = True), compile_data = [])
