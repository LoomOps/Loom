load("@rules_rust//rust:defs.bzl", "rust_library", "rust_binary", "rust_test")
load("@crates//:defs.bzl", "all_crate_deps", "aliases")
package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])
filegroup(name = "sources", srcs = glob(["src/**", "Cargo.toml"]) + glob(["build.rs"], allow_empty = True))
rust_library(name = "host", crate_name = "loom_host", srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]), edition = "2021", version = "0.2.0", aliases = aliases(), deps = ["//rust/crates/domain:domain", "//rust/crates/primitives:primitives"] + all_crate_deps(normal = True), compile_data = [])
rust_binary(name = "loom-host", crate_name = "loom_host", srcs = ["src/main.rs"], edition = "2021", version = "0.2.0", aliases = aliases(), deps = [":host"] + ["//rust/crates/domain:domain", "//rust/crates/primitives:primitives"] + all_crate_deps(normal = True))

rust_test(name = "host_test", crate_name = "host_faults", crate_root = "//tests/rust:host.rs", srcs = ["//tests/rust:host.rs"], edition = "2021", aliases = aliases(), deps = [":host", "//rust/crates/primitives:primitives"] + all_crate_deps(normal = True))
