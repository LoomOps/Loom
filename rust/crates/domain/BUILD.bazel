load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])
rust_library(name = "domain", crate_name = "loom_domain", srcs = glob(["src/**/*.rs"]), edition = "2021")
rust_test(name = "domain_test", crate_root = "src/lib.rs", srcs = glob(["src/**/*.rs"]) + ["//tests/rust:domain.rs"], edition = "2021")

filegroup(name = "sources", srcs = glob(["src/**", "Cargo.toml"]))
