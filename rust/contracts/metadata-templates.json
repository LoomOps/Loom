          },
          "status": {
            "enum": [
              "recorded",
              "unrecorded",
              "not_applicable"
            ]
          },
          "split": {
            "type": "object",
            "maxProperties": 24,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "enum": [
                    "unrecorded",
                    "not_applicable"
                  ]
                }
              ]
            }
          },
          "source_demos": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "frames": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "recorded"
                }
              }
            },
            "then": {
              "required": [
                "count",
                "unit"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unrecorded",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "count"
                    ]
                  },
                  {
                    "required": [
                      "unit"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "model": {
        "type": "object",
        "properties": {
          "role": {
