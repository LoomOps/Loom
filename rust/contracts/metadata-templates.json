          },
          "collision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "collection": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "episodes",
              "frames",
              "samples",
              "cases",
              "conditions",
              "clips",
              "snapshots",
              "trajectories",
              "transitions"
