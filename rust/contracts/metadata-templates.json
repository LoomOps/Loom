{
  "schema": {
    "type": "object",
    "properties": {
      "robot": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "recorded",
              "unrecorded",
              "not_applicable",
              "multiple"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "models": {
            "type": "array",
            "minItems": 2,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mechanical_dof": {
            "type": "integer",
            "minimum": 0,
            "maximum": 512
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "recorded"
                }
              }
            },
            "then": {
              "required": [
                "model"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "multiple"
                }
              }
            },
            "then": {
              "required": [
                "models"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "unrecorded",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "model"
                    ]
                  },
                  {
                    "required": [
                      "models"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "recorded"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "models"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "multiple"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "model"
                ]
              }
            }
          }
        ]
      },
      "environment": {
        "enum": [
          "sim",
          "real",
          "mixed",
          "unrecorded",
          "not_applicable"
        ]
      },
      "purpose": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "inputs": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "rgb",
                "depth",
                "rgbd",
                "vision",
                "state",
                "proprioception",
                "joint_state",
                "action",
                "instruction",
                "depth_validity",
                "camera_intrinsics",
                "camera_transform",
                "object_ground_truth",
                "other"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "status": {
              "enum": [
                "present",
                "absent",
                "unrecorded",
                "not_applicable"
              ]
            },
            "dimensions": {
              "type": "integer",
              "minimum": 0
            },
            "shape": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "dtype": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "used_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "preprocessing": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "physics": {
        "type": "object",
        "properties": {
          "physics_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "control_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rgb_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "state_hz": {
            "type": "number",
